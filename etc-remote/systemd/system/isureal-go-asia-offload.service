[Unit]
Description=isureal-go serving asia users' heavy GETs (memories/export/search) from the local standby
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
EnvironmentFile=/etc/isureal/local-db.env
Environment=ISUREAL_REGION=asia
Environment=ISUREAL_PORT=8085
Environment=ISUREAL_PPROF=127.0.0.1:6065
ExecStart=/usr/bin/env GOMEMLIMIT=600MiB /home/isucon/webapp/go/isureal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
