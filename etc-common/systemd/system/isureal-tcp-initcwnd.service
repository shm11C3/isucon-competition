[Unit]
Description=T-0075: larger initial TCP window on the default route (new connections to other regions)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Re-applies the current default route with initcwnd/initrwnd 64 (~93 KB);
# the route itself (gateway, device, metric) is taken from the live table.
ExecStart=/bin/sh -c 'r=$(ip -4 route show default | head -1); [ -n "$r" ] && ip route change $r initcwnd 64 initrwnd 64'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
